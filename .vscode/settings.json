{
    "files.exclude": {
		"**/.git": true,
		"**/.vs": true,
		"**/*.dll": true,
		"**/*.exe": true,
		"**/*.meta": true,
		"build/": true,
		"Build/": true,
		"Library/": true,
		"library/": true,
		"obj/": true,
		"Obj/": true,
		"Logs/": true,
		"logs/": true,
		"ProjectSettings/": true,
		"UserSettings/": true,
		"temp/": true,
		"Temp/": true
	},
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml",
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "Assignment-3.slnx"
}