  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableAsset
  asset:
    name: House
    explanation: This house is privately owned. The property owner is responsible
      for its maintenance and repairs, not the local council.
    councilOwned: 0
    category: Residential
    description: A privately owned residential house located within the suburban
      neighbourhood.
    locationDescription: A privately owned house situated along a residential street
      in the suburban neighbourhood, surrounded by trees and nearby community spaces.
    icon: {fileID: 0}
    question: Who is responsible for maintaining this asset?
    realWorldPurpose: Houses provide shelter, safety and a comfortable living environment
      for individuals and families.
    responsibilityDetails: The property owner is generally responsible for maintaining
      the house, including its roof, walls, plumbing and other private features.
      The local council maintains public infrastructure but does not normally repair
      privately owned homes.
    interestingFact: Although homeowners maintain their own properties, certain renovations
      and building works still require permits or approval from the local council.
    interactionHint: Press the Interact key to inspect.
