  m_Script: {fileID: 11500000, guid: 5a1877ad5d817434998122be3923489f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableAsset
  asset:
    name: Public Bench
    explanation: This public bench is maintained by the local council. The council
      is responsible for keeping it clean, safe and in good condition for community
      use.
    councilOwned: 1
    category: Parks & Recreation
    description: A wooden public bench that provides seating for pedestrians, residents
      and visitors in the suburban neighbourhood.
    locationDescription: Located on a grassy area beside a suburban footpath, providing
      a convenient resting place for pedestrians.
    icon: {fileID: 0}
    question: Who is responsible for maintaining this asset?
    realWorldPurpose: Public benches provide comfortable places for people to rest,
      socialise and enjoy outdoor spaces. They also make neighbourhoods more accessible
      for elderly residents and people with limited mobility.
    responsibilityDetails: The local council is responsible for inspecting, repairing
      and maintaining council-owned public benches. This includes replacing damaged
      wooden panels, repairing supports and ensuring the seating remains safe for
      public use.
    interestingFact: Public benches help make neighbourhoods more walkable by giving
      pedestrians places to rest during longer journeys.
    interactionHint: Press the Interact key to inspect.
